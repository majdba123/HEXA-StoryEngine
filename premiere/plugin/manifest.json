{
  "manifestVersion": 5,
  "id": "com.hexa.storyengine",
  "name": "HEXA StoryEngine",
  "shortname": "HEXA",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "https://127.0.0.1:8765",
        "http://127.0.0.1:8765"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "hexa-panel",
      "type": "panel",
      "label": { "default": "HEXA" },
      "minimumSize": { "width": 320, "height": 440 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 420, "height": 680 }
    }
  ]
}
